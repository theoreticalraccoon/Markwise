# Copy to ingest/.env and fill in. Never commit the real file.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The service-role key bypasses RLS. It belongs here and nowhere else.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini keys from https://aistudio.google.com/apikey, comma-separated.
# Free-tier limits are per key, so each extra key adds throughput.
GEMINI_API_KEYS=

# Optional. The chat models are a fallback chain, tried left to right.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Parallel paper groups. Keep near (number of keys x 2).
INGEST_CONCURRENCY=4
EMBED_BATCH=96

# 0 = regex parsers only: free and fast, but messy layouts parse badly.
INGEST_LLM_PARSE=1
INGEST_LLM_CLASSIFY=1
